{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{data/**,src/data/**,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api($|/)).*)",
      "destination": "/index.html"
    }
  ]
}
